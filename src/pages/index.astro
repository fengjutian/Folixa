---
const features = [
  ['01','读得顺','连续页面、瓦片渲染与邻页预取，让 500 页文档也能稳定浏览。缩放、旋转、适应宽度与全文搜索都在手边。'],
  ['02','改得稳','高亮、便签、墨迹与页面调整共用统一撤销栈。保存前重新打开校验，再原子替换并保留备份。'],
  ['03','问得准','AI 只发送你确认的页面或选区；整篇问答使用本地混合检索，引用会离线逐字核验。']
];
const steps = [
  ['01','准备工具链','自动安装固定版本的 Qt 6.8.3 与 MinGW，无需管理员权限。','powershell -ExecutionPolicy Bypass -File scripts\\bootstrap-toolchain.ps1'],
  ['02','获取 PDFium','下载固定 API 版本并校验 SHA-256，保证构建输入可复现。','powershell -ExecutionPolicy Bypass -File scripts\\bootstrap-pdfium.ps1'],
  ['03','配置与构建','使用仓库自带的 CMake Preset 生成 Debug 构建。','cmake --preset windows-debug\ncmake --build --preset windows-debug'],
  ['04','启动 Folixa','主程序会自动拉起 PdfAiWorker 并完成健康检查。','.\\build\\windows-debug\\bin\\AiPdfEditor.exe']
];
const workflow = [
  ['打开与定位','缩略图、目录、书签、页面链接和全文搜索，快速抵达需要处理的内容。'],
  ['批注与整理','选择文字后高亮或划线，也可添加便签、矩形、墨迹，并调整页面顺序。'],
  ['让 AI 处理上下文','总结当前页、解释或翻译选区；整篇提问时先查看引用核验状态。'],
  ['安全保存','先校验临时文件，再原子替换；原文件旁会保留一份可恢复的备份。']
];
const guides = [
  { icon:'01', title:'打开与阅读', lead:'从文件进入文档，再快速抵达目标内容。', items:['点击「打开 PDF」、拖入文件，或把 PDF 路径作为启动参数','使用缩略图、目录与书签跳转；内部链接直接跳页','Ctrl+F 全文搜索，结果可逐条跳转并高亮','用“适应宽度 / 适应页面”或 Ctrl++、Ctrl+- 调整视图'] },
  { icon:'02', title:'批注与审阅', lead:'所有改动可撤销，并真正写入 PDF。', items:['拖选文字后使用高亮、下划线或删除线','添加便签、矩形、墨迹、图章、附件或录音批注','在批注面板定位、回复、设置审阅状态或删除','Ctrl+Z 撤销，Ctrl+Shift+Z 重做'] },
  { icon:'03', title:'页面与安全', lead:'整理页面，保存时保护原始文件。', items:['插入空白页、删除、旋转、移动或提取页面','可设置 AES-256 加密、打开密码和文档权限','Ctrl+S 保存；首次编辑的新文档请使用“另存为”','保存失败不改原件；成功后保留 .folixa.bak 备份'] },
  { icon:'04', title:'OCR 扫描识别', lead:'让图片型 PDF 也能被检索与理解。', items:['打开扫描件并进入 OCR / 快速识别功能','优先使用 PATH 或 tools/tess/ 中的 Tesseract','未安装 Tesseract 时自动回退 Windows OCR','识别结果进入本地索引，可搜索并供整篇问答引用'] },
  { icon:'05', title:'AI 助手', lead:'明确上下文范围，回答可追溯。', items:['在设置中选择 OpenAI 兼容服务、地址与模型','API 密钥写入 Windows 凭据管理器，不进日志','总结当前页，或先选中文字再解释、翻译','整篇问答只发送检索到的片段，并离线核验引用'] },
  { icon:'06', title:'恢复与隐私', lead:'任务可取消，数据边界清楚可见。', items:['发送前确认“第 N 页 · M 字”的实际范围','索引保存在本地；文档内容被视为不可信输入','生成、搜索和 OCR 等长任务均支持取消','异常退出后，下次启动可恢复未保存的编辑命令'] }
];
const shortcuts = [
  ['Ctrl + O','打开 PDF'],['Ctrl + S','保存文档'],['Ctrl + F','全文搜索'],['Ctrl + C','复制选中文本'],
  ['Ctrl + Z','撤销'],['Ctrl + Shift + Z','重做'],['Ctrl + H','高亮选区'],['Ctrl + U','下划线选区'],
  ['Ctrl + 1','单页布局'],['Ctrl + 2','双页布局'],['Ctrl + 3','封面双页'],['F5','进入放映模式']
];
const faqs = [
  ['构建时提示 Permission denied？','通常是 AiPdfEditor.exe 仍在运行。先关闭 Folixa 窗口，再重新执行构建命令。'],
  ['扫描页为什么搜不到文字？','先运行 OCR。Folixa 优先使用 Tesseract，未安装时在 Windows 10 及以上系统回退到系统 OCR。'],
  ['没有 API 密钥能使用吗？','可以。AI 面板会进入明确标注的演示模式；阅读、编辑、OCR 和本地索引不依赖云端密钥。'],
  ['完整流水线会影响桌面吗？','会。界面验收脚本会抢占前台并移动鼠标；共享开发机请运行 scripts\\ci.ps1 -SkipAcceptance。']
];
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content="Folixa AI PDF Editor 项目介绍、构建和使用指南"/>
  <link rel="icon" href="/folixa-icon.svg"/><title>Folixa · 智能 PDF 工作空间</title>
  <style is:global>
    :root{--ink:#182033;--muted:#687086;--line:#dde2ee;--blue:#5277e8;--blue2:#3555b7;--navy:#11182a}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);font-family:Inter,"Noto Sans SC","Microsoft YaHei",system-ui,sans-serif;line-height:1.65}a{color:inherit;text-decoration:none}.wrap{width:min(1180px,calc(100% - 48px));margin:auto}nav{height:76px;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:11px;font-size:19px;font-weight:800}.brand img{width:31px}.navlinks{display:flex;align-items:center;gap:30px;font-size:14px;color:#515b72}.navlinks a:hover{color:var(--blue)}.nav-cta{padding:9px 16px;border:1px solid var(--line);border-radius:9px;background:#fff}
    .hero{padding:86px 0 96px;overflow:hidden;background:radial-gradient(circle at 76% 16%,#5277e821,transparent 29%),linear-gradient(#fafbff,#fff 84%)}.hero-grid{display:grid;grid-template-columns:1fr 1.08fr;gap:68px;align-items:center}.eyebrow{color:var(--blue2);font-weight:800;font-size:13px;letter-spacing:.14em;text-transform:uppercase}h1{font-size:clamp(48px,6vw,76px);line-height:1.06;letter-spacing:-.055em;margin:18px 0 26px}h1 span{color:var(--blue)}.lead{color:var(--muted);font-size:18px;margin:0 0 34px}.actions{display:flex;gap:12px}.btn{display:inline-flex;align-items:center;min-height:48px;padding:0 22px;border:1px solid var(--line);border-radius:10px;font-weight:700;transition:.2s;background:#fff}.btn:hover{transform:translateY(-2px);box-shadow:0 10px 24px #2834581a}.btn.primary{color:#fff;background:var(--blue);border-color:var(--blue);box-shadow:0 10px 30px #5277e83d}.version{display:flex;gap:18px;margin-top:26px;color:#7c8498;font-size:13px}.version span:before{content:'●';color:#55a879;margin-right:7px;font-size:8px}
    .product{border:1px solid #d8deea;border-radius:18px;background:#e8ebf1;padding:9px;box-shadow:0 34px 80px #202c4d2e;transform:perspective(1200px) rotateY(-2deg)}.window{height:420px;overflow:hidden;border-radius:11px;background:#f5f6f9;border:1px solid #cfd5df}.titlebar{height:34px;background:#fff;border-bottom:1px solid #e2e5ec;display:flex;align-items:center;padding:0 12px;gap:7px;font-size:9px;color:#7a8292}.appmark{width:15px;height:15px;border-radius:3px;background:linear-gradient(135deg,#8556ec,#6031cc);color:#fff;display:grid;place-items:center;font-weight:900}.controls{margin-left:auto;letter-spacing:7px}.tabs{height:27px;background:#fff;display:flex;gap:15px;align-items:end;padding:0 15px;font-size:8px;color:#566073}.tabs b{color:#5825c8;border-bottom:2px solid #7139e8;padding-bottom:5px}.ribbon{height:55px;background:#fff;border-bottom:1px solid #dfe3eb;display:flex;align-items:center;gap:13px;padding:0 18px;color:#687184;font-size:8px}.tool{display:grid;justify-items:center;gap:3px;min-width:35px}.tool i{width:17px;height:15px;border:2px solid #88909c;border-radius:3px}.workspace{height:304px;display:grid;grid-template-columns:54px 1fr 116px}.sidebar{background:#fbfcfe;border-right:1px solid #dfe3eb;padding-top:13px;display:grid;align-content:start;justify-items:center;gap:17px;color:#536077}.canvas{background:#e1e3e7;padding:26px 34px}.page{height:255px;background:#fff;box-shadow:0 4px 14px #222b3c26;padding:28px 32px;font-family:Georgia,"Songti SC",serif;color:#3b3c42}.page h3{text-align:center;margin:0 0 16px;font-size:15px}.page p{margin:7px 0;font-size:9px;line-height:1.8}.page .section-title{font-weight:700;font-size:10px;margin-top:13px}.ai-panel{background:#fff;border-left:1px solid #dfe3eb;padding:14px 10px;font-size:8px}.ai-head{color:#7139e8;font-weight:800;font-size:10px;margin-bottom:13px}.bubble{background:#f5f1ff;border:1px solid #e8e0fb;border-radius:8px;padding:9px;color:#5d5570}
    .capabilities,.usage{padding:110px 0}.section-head{display:flex;justify-content:space-between;align-items:end;gap:40px;margin-bottom:54px}h2{font-size:clamp(34px,4vw,48px);line-height:1.18;letter-spacing:-.04em;margin:10px 0 0}.section-head p{max-width:440px;color:var(--muted);margin:0}.cards{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line)}.card{padding:34px 34px 20px 0;min-height:240px;border-right:1px solid var(--line)}.card+.card{padding-left:34px}.card:last-child{border:0}.num{color:var(--blue);font:700 12px monospace}.card h3{font-size:25px;margin:34px 0 14px}.card p{color:var(--muted);margin:0;font-size:15px}
    .quickstart{background:var(--navy);color:#fff;padding:110px 0}.quickstart .eyebrow{color:#9bb1ff}.quickstart .section-head p{color:#aab2c5}.steps{border-top:1px solid #31394d}.step{display:grid;grid-template-columns:64px 210px 1fr 1.15fr;gap:28px;align-items:center;min-height:122px;border-bottom:1px solid #31394d}.step-num{color:#8490ab;font:13px monospace}.step h3{font-size:18px}.step p{color:#9fa8bc;font-size:14px}.code{position:relative;background:#090e1b;border:1px solid #30394f;border-radius:9px;padding:14px 46px 14px 16px;color:#ccd6f6;font:12px/1.6 Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere}.copy{position:absolute;top:9px;right:9px;width:30px;height:30px;border:0;border-radius:6px;color:#9aa5bd;background:#1a2234;cursor:pointer}.copy:hover{color:#fff}
    .usage-grid{display:grid;grid-template-columns:.86fr 1.14fr;gap:90px}.usage h2{margin-bottom:22px}.intro{color:var(--muted)}.tip{margin-top:34px;border-left:3px solid var(--blue);padding:5px 0 5px 18px;color:#596278;font-size:14px}.checklist{display:grid;gap:14px}.check{border:1px solid var(--line);border-radius:12px;padding:19px 20px;display:grid;grid-template-columns:34px 1fr;gap:12px;transition:.2s}.check:hover{transform:translateX(4px);border-color:#bec9e8}.check-icon{width:24px;height:24px;border-radius:50%;background:#edf1ff;color:var(--blue);display:grid;place-items:center;font-weight:bold;font-size:12px}.check h3{margin:0 0 4px;font-size:16px}.check p{margin:0;color:var(--muted);font-size:13px}
    .manual{padding:110px 0;background:#f6f8fc;border-block:1px solid #e8ebf2}.manual-head{text-align:center;max-width:720px;margin:0 auto 56px}.manual-head p{color:var(--muted);margin:18px auto 0}.guide-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.guide{background:#fff;border:1px solid var(--line);border-radius:16px;padding:30px;display:grid;grid-template-columns:48px 1fr;gap:17px;box-shadow:0 4px 14px #202c4d08}.guide-no{width:42px;height:42px;border-radius:11px;background:#edf1ff;color:var(--blue);display:grid;place-items:center;font:800 12px monospace}.guide h3{font-size:20px;margin:0 0 4px}.guide-lead{color:var(--muted);font-size:14px;margin:0 0 16px}.guide ul{list-style:none;margin:0;padding:0;display:grid;gap:9px}.guide li{position:relative;padding-left:18px;color:#4f586d;font-size:13px}.guide li:before{content:'✓';position:absolute;left:0;color:#4ea879;font-weight:800}
    .shortcuts{padding:110px 0}.shortcut-layout{display:grid;grid-template-columns:360px 1fr;gap:80px}.shortcut-layout h2{margin-bottom:18px}.shortcut-layout .intro{font-size:15px}.key-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.key-row{display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid var(--line);padding:13px 4px;color:#586176;font-size:13px}.key-row kbd{white-space:nowrap;background:#f4f6fa;border:1px solid #d8deea;border-bottom-width:2px;border-radius:6px;padding:4px 8px;color:#30394e;font:700 11px Consolas,monospace}
    .faq{padding:110px 0;background:var(--navy);color:#fff}.faq .eyebrow{color:#9bb1ff}.faq-list{margin-top:46px;border-top:1px solid #30394c}.faq details{border-bottom:1px solid #30394c}.faq summary{list-style:none;cursor:pointer;padding:24px 44px 24px 0;font-size:17px;font-weight:700;position:relative}.faq summary::-webkit-details-marker{display:none}.faq summary:after{content:'＋';position:absolute;right:4px;color:#9bb1ff;font-size:22px;font-weight:400}.faq details[open] summary:after{content:'－'}.faq details p{margin:-8px 0 25px;max-width:760px;color:#aeb7ca;font-size:14px}footer{border-top:1px solid var(--line);padding:34px 0;color:#737c91;font-size:13px}.footer-row{display:flex;align-items:center;justify-content:space-between;gap:20px}
    @media(max-width:900px){.hero-grid,.usage-grid,.shortcut-layout{grid-template-columns:1fr}.guide-grid{grid-template-columns:1fr}.product{max-width:650px}.cards{grid-template-columns:1fr}.card,.card+.card{padding:28px 0;border-right:0;border-bottom:1px solid var(--line);min-height:0}.step{grid-template-columns:44px 1fr;padding:24px 0}.step p,.step .code{grid-column:2}.section-head{align-items:start;flex-direction:column}}@media(max-width:600px){.wrap{width:calc(100% - 30px)}.navlinks a:not(.nav-cta){display:none}h1{font-size:46px}.window{height:340px}.workspace{grid-template-columns:45px 1fr;height:224px}.ai-panel{display:none}.canvas{padding:18px 12px}.page{height:200px;padding:20px}.capabilities,.quickstart,.usage,.manual,.shortcuts,.faq{padding:76px 0}.guide{grid-template-columns:1fr;padding:24px}.key-grid{grid-template-columns:1fr}.footer-row{align-items:flex-start;flex-direction:column}}
  </style>
</head>
<body>
  <header class="wrap"><nav aria-label="主导航"><a class="brand" href="#top"><img src="/folixa-icon.svg" alt=""/>Folixa</a><div class="navlinks"><a href="#features">能力</a><a href="#start">安装</a><a href="#guide">使用指南</a><a href="#shortcuts">快捷键</a><a class="nav-cta" href="#start">本地构建 →</a></div></nav></header>
  <main id="top">
    <section class="hero"><div class="wrap hero-grid"><div><div class="eyebrow">AI PDF Editor · Windows</div><h1>让文档成为<br/><span>智能工作空间。</span></h1><p class="lead">Folixa 是采用 C++20、Qt 6 与 PDFium 构建的原生 PDF 编辑器。专注阅读、可靠编辑与可验证的 AI 协作。</p><div class="actions"><a class="btn primary" href="#start">开始构建</a><a class="btn" href="#features">了解能力 →</a></div><div class="version"><span>当前版本 0.15.0</span><span>中文 / English</span></div></div>
      <div class="product" aria-label="Folixa 应用界面示意图"><div class="window"><div class="titlebar"><i class="appmark">F</i><span>加分项目（综合测评加分）.pdf — Folixa</span><span class="controls">— □ ×</span></div><div class="tabs"><b>工作台</b><span>文件</span><span>主页</span><span>转换</span><span>编辑</span><span>页面管理</span><span>AI 助手</span></div><div class="ribbon">{['文档概述','标签','分类','全文搜索','批量重命名'].map(x=><span class="tool"><i></i>{x}</span>)}</div><div class="workspace"><aside class="sidebar"><span>▦</span><span>☷</span><span>⌑</span><span>⌕</span></aside><div class="canvas"><article class="page"><h3>综合测评加分项目</h3><p>考生在取得科学技术成果、文体竞赛、获得证书、德育实践等方面表现突出或平时表现优秀的，可给予综合测评加分。</p><p class="section-title">一、科学技术成果类加分：</p><p>（一）发表文章</p><p>在校内刊物发表文章，每篇加 5 分。</p><p>在校级以上公开出版物发表文章，每篇加 10 分。</p></article></div><aside class="ai-panel"><div class="ai-head">✦ AI 助手</div><div class="bubble">我可以总结当前页、解释选区，或基于整篇文档回答问题。<br/><br/>引用 · 第 1 页</div></aside></div></div></div>
    </div></section>
    <section class="capabilities wrap" id="features"><div class="section-head"><div><div class="eyebrow">核心能力</div><h2>文档在中心，<br/>智能在上下文中。</h2></div><p>从长文档浏览、真实 PDF 批注，到带离线引用核验的整篇问答，每一步都保留用户控制权。</p></div><div class="cards">{features.map(([n,title,text])=><article class="card"><span class="num">{n}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
    <section class="quickstart" id="start"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Quick start</div><h2>四步，在 Windows<br/>跑起 Folixa。</h2></div><p>请在项目根目录打开 PowerShell。工具链与 PDFium 下载脚本均不需要管理员权限。</p></div><div class="steps">{steps.map(([n,title,text,code])=><article class="step"><span class="step-num">{n}</span><h3>{title}</h3><p>{text}</p><div class="code">{code}<button class="copy" type="button" aria-label={`复制${title}命令`} data-copy={code}>▣</button></div></article>)}</div></div></section>
    <section class="usage wrap" id="workflow"><div class="usage-grid"><div><div class="eyebrow">日常使用</div><h2>打开文档，<br/>继续你的工作。</h2><p class="intro">启动后拖入 PDF，或直接把文件路径作为命令行参数。扫描件会优先调用本机 Tesseract，未安装时回退到 Windows OCR。</p><div class="tip">AI 密钥保存在 Windows 凭据管理器，不写入配置文件或日志；未配置时可使用明确标注的演示模式。</div></div><div class="checklist">{workflow.map(([title,text],i)=><article class="check"><span class="check-icon">{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div></div></section>
    <section class="manual" id="guide"><div class="wrap"><div class="manual-head"><div class="eyebrow">使用指南</div><h2>从第一次打开，<br/>到放心保存。</h2><p>六个高频场景覆盖完整使用路径。每一步都对应当前版本中已经实现的功能。</p></div><div class="guide-grid">{guides.map((g)=><article class="guide"><span class="guide-no">{g.icon}</span><div><h3>{g.title}</h3><p class="guide-lead">{g.lead}</p><ul>{g.items.map(item=><li>{item}</li>)}</ul></div></article>)}</div></div></section>
    <section class="shortcuts wrap" id="shortcuts"><div class="shortcut-layout"><div><div class="eyebrow">效率工具</div><h2>常用操作，<br/>不必离开键盘。</h2><p class="intro">快捷键在文档视图中生效。焦点位于输入框时，复制等系统快捷键仍按输入框行为处理。</p><div class="tip">布局切换会记住当前文档的阅读状态；F5 可进入专注放映模式。</div></div><div class="key-grid">{shortcuts.map(([key,label])=><div class="key-row"><span>{label}</span><kbd>{key}</kbd></div>)}</div></div></section>
    <section class="faq" id="faq"><div class="wrap"><div class="eyebrow">常见问题</div><h2>遇到问题，<br/>先从这里开始。</h2><div class="faq-list">{faqs.map(([q,a],i)=><details open={i===0}><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
  </main>
  <footer><div class="wrap footer-row"><span class="brand"><img src="/folixa-icon.svg" alt=""/>Folixa</span><span>C++20 · Qt 6 · PDFium · Windows</span><span>项目使用说明 · v0.15.0</span></div></footer>
  <script>document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button=>button.addEventListener('click',async()=>{await navigator.clipboard.writeText(button.dataset.copy??'');const old=button.textContent;button.textContent='✓';setTimeout(()=>button.textContent=old,1200)}));</script>
</body>
</html>
