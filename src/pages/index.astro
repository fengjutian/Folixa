---
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import '../styles/global.css';

// ── 站点地址 ─────────────────────────────────────────────
// SITE / BASE 由 astro.config.mjs 提供，可用 SITE_URL / SITE_BASE 环境变量覆盖。
const SITE = import.meta.env.SITE ?? 'https://fengjutian.github.io/Folixa/';
const BASE = import.meta.env.BASE_URL ?? '/';
const canonical = new URL(BASE, SITE).href;
const ogImage = new URL('folixa-og.png', SITE).href;
const repoUrl = 'https://github.com/fengjutian/Folixa';
const docsUrl = `${repoUrl}/tree/main/docs`;

// ── 版本号直接从 CMake 读取，避免页面与发布产物脱节 ──────
function findRepoRoot() {
  let dir = process.cwd();
  for (let i = 0; i < 6; i += 1) {
    if (existsSync(resolve(dir, 'CMakeLists.txt'))) return dir;
    const parent = resolve(dir, '..');
    if (parent === dir) break;
    dir = parent;
  }
  return process.cwd();
}
const cmakeLists = readFileSync(resolve(findRepoRoot(), 'CMakeLists.txt'), 'utf8');
const version = cmakeLists.match(/project\(\s*\w+\s+VERSION\s+([0-9.]+)/)?.[1] ?? '0.0.0';

const description =
  'Folixa 是采用 C++20、Qt 6 与 PDFium 构建的原生 Windows PDF 编辑器：稳定浏览长文档、可靠批注与页面管理，以及带离线引用核验的整篇 AI 问答。';

// ── 页面内容 ─────────────────────────────────────────────
const features = [
  ['01','读得顺','连续页面、瓦片渲染与邻页预取，让 500 页文档也能稳定浏览。缩放、旋转、适应宽度与全文搜索都在手边。'],
  ['02','改得稳','高亮、便签、墨迹与页面调整共用统一撤销栈。保存前重新打开校验，再原子替换并保留备份。'],
  ['03','问得准','AI 只发送你确认的页面或选区；整篇问答使用本地混合检索，引用会离线逐字核验。']
];
const steps = [
  ['01','准备工具链','自动安装固定版本的 Qt 6.8.3 与 MinGW，无需管理员权限。','powershell -ExecutionPolicy Bypass -File scripts\\bootstrap-toolchain.ps1'],
  ['02','获取 PDFium','下载固定 API 版本并校验 SHA-256，保证构建输入可复现。','powershell -ExecutionPolicy Bypass -File scripts\\bootstrap-pdfium.ps1'],
  ['03','配置与构建','使用仓库自带的 CMake Preset 生成 Debug 构建。','cmake --preset windows-debug\ncmake --build --preset windows-debug'],
  ['04','启动 Folixa','主程序会自动拉起 PdfAiWorker 并完成健康检查。','.\\build\\windows-debug\\bin\\AiPdfEditor.exe']
];
const workflow = [
  ['打开与定位','缩略图、目录、书签、页面链接和全文搜索，快速抵达需要处理的内容。'],
  ['批注与整理','选择文字后高亮或划线，也可添加便签、矩形、墨迹，并调整页面顺序。'],
  ['让 AI 处理上下文','总结当前页、解释或翻译选区；整篇提问时先查看引用核验状态。'],
  ['安全保存','先校验临时文件，再原子替换；原文件旁会保留一份可恢复的备份。']
];
const guides = [
  { icon:'01', title:'打开与阅读', lead:'从文件进入文档，再快速抵达目标内容。', items:['点击「打开 PDF」、拖入文件，或把 PDF 路径作为启动参数','使用缩略图、目录与书签跳转；内部链接直接跳页','Ctrl+F 全文搜索，结果可逐条跳转并高亮','用“适应宽度 / 适应页面”或 Ctrl++、Ctrl+- 调整视图'] },
  { icon:'02', title:'批注与审阅', lead:'所有改动可撤销，并真正写入 PDF。', items:['拖选文字后使用高亮、下划线或删除线','添加便签、矩形、墨迹、图章、附件或录音批注','在批注面板定位、回复、设置审阅状态或删除','Ctrl+Z 撤销，Ctrl+Shift+Z 重做'] },
  { icon:'03', title:'页面与安全', lead:'整理页面，保存时保护原始文件。', items:['插入空白页、删除、旋转、移动或提取页面','可设置 AES-256 加密、打开密码和文档权限','Ctrl+S 保存；首次编辑的新文档请使用“另存为”','保存失败不改原件；成功后保留 .folixa.bak 备份'] },
  { icon:'04', title:'OCR 扫描识别', lead:'让图片型 PDF 也能被检索与理解。', items:['打开扫描件并进入 OCR / 快速识别功能','优先使用 PATH 或 tools/tess/ 中的 Tesseract','未安装 Tesseract 时自动回退 Windows OCR','识别结果进入本地索引，可搜索并供整篇问答引用'] },
  { icon:'05', title:'AI 助手', lead:'明确上下文范围，回答可追溯。', items:['在设置中选择 OpenAI 兼容服务、地址与模型','API 密钥写入 Windows 凭据管理器，不进日志','总结当前页，或先选中文字再解释、翻译','整篇问答只发送检索到的片段，并离线核验引用'] },
  { icon:'06', title:'恢复与隐私', lead:'任务可取消，数据边界清楚可见。', items:['发送前确认“第 N 页 · M 字”的实际范围','索引保存在本地；文档内容被视为不可信输入','生成、搜索和 OCR 等长任务均支持取消','异常退出后，下次启动可恢复未保存的编辑命令'] }
];
const shortcuts = [
  ['Ctrl + O','打开 PDF'],['Ctrl + S','保存文档'],['Ctrl + F','全文搜索'],['Ctrl + C','复制选中文本'],
  ['Ctrl + Z','撤销'],['Ctrl + Shift + Z','重做'],['Ctrl + H','高亮选区'],['Ctrl + U','下划线选区'],
  ['Ctrl + 1','单页布局'],['Ctrl + 2','双页布局'],['Ctrl + 3','封面双页'],['F5','进入放映模式']
];
const faqs = [
  ['构建时提示 Permission denied？','通常是 AiPdfEditor.exe 仍在运行。先关闭 Folixa 窗口，再重新执行构建命令。'],
  ['扫描页为什么搜不到文字？','先运行 OCR。Folixa 优先使用 Tesseract，未安装时在 Windows 10 及以上系统回退到系统 OCR。'],
  ['没有 API 密钥能使用吗？','可以。AI 面板会进入明确标注的演示模式；阅读、编辑、OCR 和本地索引不依赖云端密钥。'],
  ['完整流水线会影响桌面吗？','会。界面验收脚本会抢占前台并移动鼠标；共享开发机请运行 scripts\\ci.ps1 -SkipAcceptance。'],
  ['代码可以自由使用或再分发吗？','暂不可以。仓库当前保留所有权利，尚未选定最终许可证，在其确定前不授予再分发、修改或商用许可；第三方组件各自遵循原有许可。']
];

// ── 图标（16×16 线性图标，stroke 走 currentColor）────────
const toolIcons = [
  '<rect x="4" y="2.5" width="8" height="11" rx="1.4"/><path d="M6 5.6h4M6 8h4M6 10.4h2.6"/>',
  '<path d="M8.3 2.6 13.4 7.7 7.7 13.4 2.6 8.3z"/><circle cx="6.2" cy="6.2" r="1"/>',
  '<path d="M2.6 4.3h3.8l1.3 1.7h5.7v7.2H2.6z"/>',
  '<circle cx="7" cy="7" r="4.2"/><path d="m10.2 10.2 3.1 3.1"/>',
  '<path d="M2.9 11.9 11 3.8l1.4 1.4-8.1 8.1H2.9z"/><path d="m9.6 5.2 1.4 1.4"/>'
];
const sideIcons = [
  '<rect x="2.4" y="2.4" width="5" height="6" rx="1"/><rect x="8.6" y="2.4" width="5" height="6" rx="1"/><rect x="2.4" y="9.6" width="5" height="4" rx="1"/>',
  '<path d="M3 4h10M3 7h10M3 10h6.5"/>',
  '<rect x="3.6" y="2.4" width="8.8" height="11.2" rx="1.2"/>',
  '<circle cx="7.2" cy="7.2" r="3.6"/><path d="m10 10 2.7 2.7"/>'
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Folixa',
  alternateName: 'AI PDF Editor',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Windows',
  description,
  softwareVersion: version,
  url: canonical,
  image: ogImage,
  codeRepository: repoUrl,
  programmingLanguage: ['C++', 'Qt', 'TypeScript'],
  featureList: features.map(([, title, text]) => `${title}：${text}`),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
};
// </script> 不能直接出现在 JSON-LD 里，统一转义
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Folixa · 智能 PDF 工作空间</title>
  <meta name="description" content={description}/>
  <meta name="color-scheme" content="light"/>
  <meta name="theme-color" content="#11182a"/>
  <link rel="canonical" href={canonical}/>

  <link rel="icon" href={`${BASE}folixa-icon.svg`} type="image/svg+xml"/>
  <link rel="icon" href={`${BASE}favicon.ico`} sizes="32x32"/>
  <link rel="apple-touch-icon" href={`${BASE}folixa-icon-192.png`}/>

  <meta property="og:type" content="website"/>
  <meta property="og:site_name" content="Folixa"/>
  <meta property="og:locale" content="zh_CN"/>
  <meta property="og:title" content="Folixa · 智能 PDF 工作空间"/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:image" content={ogImage}/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta property="og:image:alt" content="Folixa · 智能 PDF 工作空间"/>

  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content="Folixa · 智能 PDF 工作空间"/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={ogImage}/>

  <script type="application/ld+json" is:inline set:html={jsonLdText}/>
</head>
<body>
  <a class="skip-link" href="#main">跳到主要内容</a>

  <header class="wrap">
    <nav aria-label="主导航">
      <a class="brand" href="#top"><img src={`${BASE}folixa-icon.svg`} alt="" width="31" height="31"/>Folixa</a>
      <div class="navlinks">
        <a href="#features">能力</a>
        <a href="#start">安装</a>
        <a href="#guide">使用指南</a>
        <a href="#shortcuts">快捷键</a>
        <a class="nav-github" href={repoUrl} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.02-1.49-2.23.48-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.81.06 1.23.83 1.23.83.72 1.23 1.89.88 2.35.67.07-.52.28-.88.51-1.08-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.52.56.83 1.28.83 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          <span>GitHub</span>
        </a>
        <a class="nav-cta" href="#start">本地构建 →</a>
      </div>
    </nav>
  </header>

  <main id="main">
    <span id="top"></span>
    <section class="hero"><div class="wrap hero-grid"><div><div class="eyebrow">AI PDF Editor · Windows</div><h1>让文档成为<br/><span>智能工作空间。</span></h1><p class="lead">Folixa 是采用 C++20、Qt 6 与 PDFium 构建的原生 PDF 编辑器。专注阅读、可靠编辑与可验证的 AI 协作。</p><div class="actions"><a class="btn primary" href="#start">开始构建</a><a class="btn" href="#features">了解能力 →</a></div><div class="version"><span>当前版本 {version}</span><span>中文 / English</span><span>Windows x64</span></div></div>
      <div class="product" role="img" aria-label="Folixa 应用界面示意图"><div class="window"><div class="titlebar"><i class="appmark">F</i><span>加分项目（综合测评加分）.pdf — Folixa</span><span class="controls">— □ ×</span></div><div class="tabs"><b>工作台</b><span>文件</span><span>主页</span><span>转换</span><span>编辑</span><span>页面管理</span><span>AI 助手</span></div><div class="ribbon">{['文档概述','标签','分类','全文搜索','批量重命名'].map((x,i)=><span class="tool"><i class="ico" set:html={toolIcons[i]}/>{x}</span>)}</div><div class="workspace"><aside class="sidebar">{sideIcons.map(p=><span class="ico" set:html={p}/>)}</aside><div class="canvas"><article class="page"><h3>综合测评加分项目</h3><p>考生在取得科学技术成果、文体竞赛、获得证书、德育实践等方面表现突出或平时表现优秀的，可给予综合测评加分。</p><p class="section-title">一、科学技术成果类加分：</p><p>（一）发表文章</p><p>在校内刊物发表文章，每篇加 5 分。</p><p>在校级以上公开出版物发表文章，每篇加 10 分。</p></article></div><aside class="ai-panel"><div class="ai-head">✦ AI 助手</div><div class="bubble">我可以总结当前页、解释选区，或基于整篇文档回答问题。<br/><br/>引用 · 第 1 页</div></aside></div></div></div>
    </div></section>
    <section class="capabilities wrap" id="features"><div class="section-head"><div><div class="eyebrow">核心能力</div><h2>文档在中心，<br/>智能在上下文中。</h2></div><p>从长文档浏览、真实 PDF 批注，到带离线引用核验的整篇问答，每一步都保留用户控制权。</p></div><div class="cards">{features.map(([n,title,text])=><article class="card"><span class="num">{n}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
    <section class="quickstart" id="start"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Quick start</div><h2>四步，在 Windows<br/>跑起 Folixa。</h2></div><p>请在项目根目录打开 PowerShell。工具链与 PDFium 下载脚本均不需要管理员权限。</p></div><div class="steps">{steps.map(([n,title,text,code])=><article class="step"><span class="step-num">{n}</span><h3>{title}</h3><p>{text}</p><div class="code">{code}<button class="copy" type="button" aria-label={`复制${title}命令`} data-copy={code}><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="5.5" y="5.5" width="8" height="8" rx="1.6"/><path d="M10.5 5.5v-1a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 4.5V9A1.5 1.5 0 0 0 4 10.5h1"/></svg></button></div></article>)}</div></div></section>
    <section class="usage wrap" id="workflow"><div class="usage-grid"><div><div class="eyebrow">日常使用</div><h2>打开文档，<br/>继续你的工作。</h2><p class="intro">启动后拖入 PDF，或直接把文件路径作为命令行参数。扫描件会优先调用本机 Tesseract，未安装时回退到 Windows OCR。</p><div class="tip">AI 密钥保存在 Windows 凭据管理器，不写入配置文件或日志；未配置时可使用明确标注的演示模式。</div></div><div class="checklist">{workflow.map(([title,text],i)=><article class="check"><span class="check-icon">{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div></div></section>
    <section class="manual" id="guide"><div class="wrap"><div class="manual-head"><div class="eyebrow">使用指南</div><h2>从第一次打开，<br/>到放心保存。</h2><p>六个高频场景覆盖完整使用路径。每一步都对应当前版本中已经实现的功能。</p></div><div class="guide-grid">{guides.map((g)=><article class="guide"><span class="guide-no">{g.icon}</span><div><h3>{g.title}</h3><p class="guide-lead">{g.lead}</p><ul>{g.items.map(item=><li>{item}</li>)}</ul></div></article>)}</div></div></section>
    <section class="shortcuts wrap" id="shortcuts"><div class="shortcut-layout"><div><div class="eyebrow">效率工具</div><h2>常用操作，<br/>不必离开键盘。</h2><p class="intro">快捷键在文档视图中生效。焦点位于输入框时，复制等系统快捷键仍按输入框行为处理。</p><div class="tip">布局切换会记住当前文档的阅读状态；F5 可进入专注放映模式。</div></div><div class="key-grid">{shortcuts.map(([key,label])=><div class="key-row"><span>{label}</span><kbd>{key}</kbd></div>)}</div></div></section>
    <section class="faq" id="faq"><div class="wrap"><div class="eyebrow">常见问题</div><h2>遇到问题，<br/>先从这里开始。</h2><div class="faq-list">{faqs.map(([q,a],i)=><details open={i===0}><summary>{q}<svg class="chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m4 6 4 4 4-4"/></svg></summary><p>{a}</p></details>)}</div></div></section>
  </main>

  <footer><div class="wrap footer-row">
    <span class="brand"><img src={`${BASE}folixa-icon.svg`} alt="" width="31" height="31"/>Folixa</span>
    <span class="footer-meta">C++20 · Qt 6 · PDFium · Windows</span>
    <span class="footer-links">
      <a href={repoUrl} target="_blank" rel="noopener noreferrer">源码仓库</a>
      <a href={docsUrl} target="_blank" rel="noopener noreferrer">项目文档</a>
      <span>项目使用说明 · v{version}</span>
    </span>
  </div></footer>

  <p class="sr-only" role="status" aria-live="polite" id="copy-status"></p>
  <script>
    // 复制命令：navigator.clipboard 只在安全上下文（HTTPS / localhost）可用，
    // 站点若以 http:// 部署就会静默失效，这里补 execCommand 兜底并给出反馈。
    async function copyText(text) {
      if (window.isSecureContext && navigator.clipboard) {
        await navigator.clipboard.writeText(text);
        return;
      }
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.cssText = 'position:fixed;top:0;left:0;opacity:0;pointer-events:none';
      document.body.appendChild(area);
      area.select();
      area.setSelectionRange(0, area.value.length);
      const ok = document.execCommand('copy');
      document.body.removeChild(area);
      if (!ok) throw new Error('copy failed');
    }

    const status = document.getElementById('copy-status');
    document.querySelectorAll('[data-copy]').forEach((button) => {
      const original = button.innerHTML;
      const title = button.getAttribute('aria-label') ?? '命令';
      button.addEventListener('click', async () => {
        const text = button.dataset.copy ?? '';
        try {
          await copyText(text);
          button.classList.add('done');
          if (status) status.textContent = `已复制${title.replace(/^复制/, '')}`;
        } catch {
          if (status) status.textContent = '复制失败，请手动选择命令文本';
        }
        setTimeout(() => {
          button.classList.remove('done');
          button.innerHTML = original;
        }, 1600);
      });
    });
  </script>
</body>
</html>
