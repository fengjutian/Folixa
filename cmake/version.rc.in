/* Windows version resource for AI PDF Editor executables.
   Generated from cmake/version.rc.in — do not edit the generated copy. */

#include <windows.h>

/* 应用图标：@AIPDF_APP_ICON@
   由 src/app/icons/app.svg 派生，多分辨率 ICO（16-256）。 */
IDI_ICON1 ICON "@AIPDF_APP_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "AI PDF Editor Project"
            VALUE "FileDescription", "@AIPDF_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@AIPDF_INTERNAL_NAME@"
            VALUE "OriginalFilename", "@AIPDF_ORIGINAL_FILENAME@"
            VALUE "ProductName", "AI PDF Editor"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
